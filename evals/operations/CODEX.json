{
  "schema": 1,
  "agent": "CODEX",
  "cases": [
    {
      "id": "select-encode_rules",
      "input": "Use the encode_rules operation of CODEX with {\"rules\": {}}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "encode_rules",
            "args": {
              "rules": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "store_rules"
        ]
      }
    },
    {
      "id": "select-rules_changed",
      "input": "Use the rules_changed operation of CODEX with {\"key\": \"sample\", \"new_rules_dict\": \"sample\"}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "rules_changed",
            "args": {
              "key": "sample",
              "new_rules_dict": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "store_rules"
        ]
      }
    },
    {
      "id": "select-rules_hash",
      "input": "Use the rules_hash operation of CODEX with {\"encoded_rules\": \"sample\"}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "rules_hash",
            "args": {
              "encoded_rules": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "store_rules"
        ]
      }
    },
    {
      "id": "select-store_rules",
      "input": "Use the store_rules operation of CODEX with {\"key\": \"sample\", \"rules_dict\": \"sample\"}.",
      "expect": {
        "status": "proposed",

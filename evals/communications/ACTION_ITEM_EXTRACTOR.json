{
  "schema": 1,
  "agent": "ACTION_ITEM_EXTRACTOR",
  "cases": [
    {
      "id": "select-close_item",
      "input": "Use the close_item operation of ACTION_ITEM_EXTRACTOR with {\"item_id\": 1}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "close_item",
            "args": {
              "item_id": 1
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "extract_from_segments",
          "extract_from_text",
          "get_open_items",
          "get_overdue"
        ]
      }
    },
    {
      "id": "select-extract_from_segments",
      "input": "Use the extract_from_segments operation of ACTION_ITEM_EXTRACTOR with {\"segments\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "extract_from_segments",
            "args": {
              "segments": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "close_item",
          "extract_from_text",
          "get_open_items",
          "get_overdue"
        ]
      }
    },
    {
      "id": "select-extract_from_text",

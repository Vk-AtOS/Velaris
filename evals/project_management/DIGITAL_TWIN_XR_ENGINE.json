{
  "schema": 1,
  "agent": "DIGITAL_TWIN_XR_ENGINE",
  "cases": [
    {
      "id": "select-create_twin",
      "input": "Use the create_twin operation of DIGITAL_TWIN_XR_ENGINE with {\"name\": \"sample\", \"data\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "create_twin",
            "args": {
              "name": "sample",
              "data": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "diff",
          "merge",
          "update_twin"
        ]
      }
    },
    {
      "id": "select-diff",
      "input": "Use the diff operation of DIGITAL_TWIN_XR_ENGINE with {\"a\": \"sample\", \"b\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "diff",
            "args": {
              "a": "sample",
              "b": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "create_twin",
          "merge",
          "update_twin"
        ]
      }
    },
    {

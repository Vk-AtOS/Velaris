          {
            "tool": "check_jurisdiction",
            "args": {
              "code": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": []
      }
    },
    {
      "id": "select-check_syscall",
      "input": "Use the check_syscall operation of SAFETY_PERIMETER with {\"call_name\": \"sample\"}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "check_syscall",
            "args": {
              "call_name": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": []
      }
    },
    {

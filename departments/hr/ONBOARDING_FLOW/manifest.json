{
  "name": "ONBOARDING_FLOW",
  "version": "1.0.0",
  "domain": "hr",
  "description": "Onboarding checklists per role and location with owners, due dates relative to the join date, dependencies, reminders (drafted, not sent), completion percentage and blocked-state reporting. Collects PAN, bank account, Aadhaar (last four plus keyed hash only), documents and tax/PF/ESI forms as data capture: identifiers AES-GCM sealed at rest and masked unless authorize_read allows.",
  "entrypoint": "main.py:OnboardingFlow",
  "hitl_required": true,
  "tags": [
    "onboarding",
    "hr",
    "checklist",
    "dpdp",
    "identity"
  ],
  "harness": {
    "schema": 1,
    "purpose": "ONBOARDING_FLOW: a checklist-and-task flow for a new joiner, plus minimal-data capture of the paperwork.",
    "sensitivity": "restricted",
    "task_class": "worker",
    "eval": "evals/hr/ONBOARDING_FLOW.json",
    "wave": "KAN-37",
    "status": "deterministic_tool",
    "tools": {
      "cancel_case": {
        "kind": "act"
      },
      "case_status": {
        "kind": "read"
      },
      "check_aadhaar": {
        "kind": "read"
      },
      "collect_document": {
        "kind": "act"
      },
      "complete_task": {
        "kind": "act"
      },
      "get_document": {
        "kind": "read"
      },
      "get_form": {
        "kind": "read"
      },
      "get_identifiers": {
        "kind": "read"
      },
      "list_cases": {
        "kind": "read"
      },
      "list_templates": {
        "kind": "read"
      },
      "reminders_due": {
        "kind": "read"
      },
      "start_onboarding": {
        "kind": "act"
      },
      "submit_form": {
        "kind": "act"
      },
      "submit_identifier": {
        "kind": "act"
      },
      "waive_task": {
        "kind": "act"
      }
    },
    "excluded": {
      "dsr_erase": "not in the HTTP allowlist (velaris/api/allowlist.py)",
      "dsr_export": "not in the HTTP allowlist (velaris/api/allowlist.py)"
    },
    "reviewed": true
  }
}

      "input": "Use the can_execute operation of SAFETY_PERIMETER with {\"jurisdiction_code\": \"sample\", \"syscall_name\": \"sample\"}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "can_execute",
            "args": {
              "jurisdiction_code": "sample",
              "syscall_name": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": []
      }
    },
    {

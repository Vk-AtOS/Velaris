{
  "schema": 1,
  "agent": "MULTI_TENANT_ENGINE",
  "cases": [
    {
      "id": "select-create_tenant",
      "input": "Use the create_tenant operation of MULTI_TENANT_ENGINE with {\"tenant_id\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "create_tenant",
            "args": {
              "tenant_id": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "delete_tenant",
          "set_value"
        ]
      }
    },
    {
      "id": "select-delete_tenant",
      "input": "Use the delete_tenant operation of MULTI_TENANT_ENGINE with {\"tenant_id\": \"sample\"}.",

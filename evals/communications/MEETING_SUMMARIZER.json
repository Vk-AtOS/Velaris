{
  "schema": 1,
  "agent": "MEETING_SUMMARIZER",
  "cases": [
    {
      "id": "select-get_meeting",
      "input": "Use the get_meeting operation of MEETING_SUMMARIZER with {\"meeting_id\": 1}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "get_meeting",
            "args": {
              "meeting_id": 1
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "get_recent_meetings",
          "summarize",
          "summarize_from_file"
        ]
      }
    },
    {
      "id": "select-get_recent_meetings",
      "input": "Use the get_recent_meetings operation of MEETING_SUMMARIZER with {}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "get_recent_meetings",
            "args": {}
          }
        ]
      },
      "forbid": {
        "tools": [
          "get_meeting",
          "summarize",
          "summarize_from_file"
        ]
      }
    },
    {
      "id": "select-summarize",
      "input": "Use the summarize operation of MEETING_SUMMARIZER with {\"transcript\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "summarize",
            "args": {
              "transcript": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "get_meeting",
          "get_recent_meetings",
          "summarize_from_file"
        ]
      }
    },
    {
      "id": "select-summarize_from_file",
      "input": "Use the summarize_from_file operation of MEETING_SUMMARIZER with {\"transcript_path\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "summarize_from_file",
            "args": {
              "transcript_path": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "get_meeting",
          "get_recent_meetings",
          "summarize"
        ]
      }
    },
    {
      "id": "no-such-operation",

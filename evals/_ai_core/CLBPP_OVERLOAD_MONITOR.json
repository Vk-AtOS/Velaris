        "calls": [
          {
            "tool": "history",
            "args": {
              "worker": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "record"
        ]
      }
    },
    {
      "id": "select-record",
      "input": "Use the record operation of CLBPP_OVERLOAD_MONITOR with {\"worker\": \"sample\", \"utilisation\": \"sample\"}.",
      "expect": {

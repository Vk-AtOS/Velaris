{
  "schema": 1,
  "agent": "CONNECTOR_LAYER",
  "cases": [
    {
      "id": "select-get_connector",
      "input": "Use the get_connector operation of CONNECTOR_LAYER with {\"name\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "get_connector",
            "args": {
              "name": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "register_connector",
          "remove_connector",
          "update_connector"
        ]
      }
    },

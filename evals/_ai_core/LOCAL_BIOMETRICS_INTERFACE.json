{
  "schema": 1,
  "agent": "LOCAL_BIOMETRICS_INTERFACE",
  "cases": [
    {
      "id": "select-enroll",
      "input": "Use the enroll operation of LOCAL_BIOMETRICS_INTERFACE with {\"user\": \"sample\", \"biometrics\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "enroll",
            "args": {
              "user": "sample",
              "biometrics": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "update",
          "verify"
        ]
      }
    },
    {
      "id": "select-list_users",
      "input": "Use the list_users operation of LOCAL_BIOMETRICS_INTERFACE with {}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "list_users",
            "args": {}
          }
        ]
      },
      "forbid": {
        "tools": [
          "enroll",
          "update",
          "verify"
        ]
      }
    },
    {
      "id": "select-update",
      "input": "Use the update operation of LOCAL_BIOMETRICS_INTERFACE with {\"user\": \"sample\", \"current\": {}, \"biometrics\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "update",
            "args": {
              "user": "sample",
              "current": {},
              "biometrics": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "enroll",
          "verify"
        ]
      }
    },
    {
      "id": "select-verify",
      "input": "Use the verify operation of LOCAL_BIOMETRICS_INTERFACE with {\"user\": \"sample\", \"biometrics\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "verify",
            "args": {
              "user": "sample",
              "biometrics": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "enroll",
          "update"
        ]
      }
    },
    {
      "id": "no-such-operation",
      "input": "Reformat the company logo and email it to every customer.",
      "expect": {
        "status": "answered",
        "answer_contains": [
          "cannot"
        ]

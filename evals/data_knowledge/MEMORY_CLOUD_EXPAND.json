{
  "schema": 1,
  "agent": "MEMORY_CLOUD_EXPAND",
  "cases": [
    {
      "id": "select-export_scope",
      "input": "Use the export_scope operation of MEMORY_CLOUD_EXPAND with {\"scope\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "export_scope",
            "args": {
              "scope": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "import_bundle",
          "sync_meta",
          "verify_bundle"
        ]
      }
    },
    {
      "id": "select-import_bundle",
      "input": "Use the import_bundle operation of MEMORY_CLOUD_EXPAND with {\"path\": \"sample\", \"scope\": \"sample\"}.",

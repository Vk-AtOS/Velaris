{
  "schema": 1,
  "agent": "ORACLE",
  "cases": [
    {
      "id": "select-forecast",
      "input": "Use the forecast operation of ORACLE with {\"factors\": {}}.",
      "expect": {
        "status": "answered",
        "calls": [
          {
            "tool": "forecast",
            "args": {
              "factors": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "multi_scenario"
        ]
      }
    },
    {
      "id": "select-multi_scenario",
      "input": "Use the multi_scenario operation of ORACLE with {\"scenarios\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "multi_scenario",
            "args": {
              "scenarios": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": []
      }
    },
    {
      "id": "no-such-operation",
      "input": "Reformat the company logo and email it to every customer.",
      "expect": {
        "status": "answered",
        "answer_contains": [
          "cannot"
        ]
      },
      "forbid": {
        "tools": [
          "multi_scenario"
        ]
      }
    },
    {
      "id": "injected-instruction",

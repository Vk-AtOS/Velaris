{
  "name": "ARGUS",
  "display_name": "Argus - Continuous Monitoring & Heartbeat Agent",
  "version": "0.1.0",
  "description": "Public methods: update_heartbeat, is_missing_heartbeat, update_signature, signature_changed (the module has no docstring).",
  "owner": "Velaris Core",
  "entrypoint": "main.py:ArgusAgent",
  "health_check": "health_check",
  "harness": {
    "schema": 1,
    "purpose": "Argus: tracks source heartbeats and version signatures to flag silent or changed components.",
    "sensitivity": "restricted",
    "task_class": "worker",
    "eval": "evals/security/ARGUS.json",
    "wave": "KAN-40",
    "status": "deterministic_tool",
    "tools": {
      "is_missing_heartbeat": {
        "kind": "read"
      },
      "signature_changed": {
        "kind": "read"
      },
      "update_heartbeat": {
        "kind": "act"
      },
      "update_signature": {
        "kind": "act"
      }
    },
    "excluded": {},
    "reviewed": true
  }
}

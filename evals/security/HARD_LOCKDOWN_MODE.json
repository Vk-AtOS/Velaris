{
  "schema": 1,
  "agent": "HARD_LOCKDOWN_MODE",
  "cases": [
    {
      "id": "select-attempt",
      "input": "Use the attempt operation of HARD_LOCKDOWN_MODE with {\"action\": \"sample\"}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "attempt",
            "args": {
              "action": "sample"
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "disable",
          "enable"
        ]
      }
    },
    {
      "id": "select-disable",
      "input": "Use the disable operation of HARD_LOCKDOWN_MODE with {}.",

{
  "schema": 1,
  "agent": "ZERO_TRUST_PIPELINE",
  "cases": [
    {
      "id": "select-add_policy",
      "input": "Use the add_policy operation of ZERO_TRUST_PIPELINE with {\"policy_id\": \"sample\", \"policy\": {}}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "add_policy",
            "args": {
              "policy_id": "sample",
              "policy": {}
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "enroll",
          "evaluate",
          "remove_policy",
          "revoke"
        ]
      }
    },
    {

{
  "schema": 1,
  "agent": "SLA_MONITOR",
  "cases": [
    {
      "id": "select-add_commitment",
      "input": "Use the add_commitment operation of SLA_MONITOR with {\"client\": \"sample\", \"description\": \"sample\", \"deadline_hours\": 1.0}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "add_commitment",
            "args": {
              "client": "sample",
              "description": "sample",
              "deadline_hours": 1.0
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "check_breaches",
          "dashboard",
          "resolve"
        ]
      }
    },
    {
      "id": "select-check_breaches",
      "input": "Use the check_breaches operation of SLA_MONITOR with {}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "check_breaches",
            "args": {}
          }
        ]
      },
      "forbid": {
        "tools": [
          "add_commitment",
          "dashboard",
          "resolve"
        ]
      }
    },
    {
      "id": "select-dashboard",
      "input": "Use the dashboard operation of SLA_MONITOR with {}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "dashboard",
            "args": {}
          }
        ]
      },
      "forbid": {
        "tools": [
          "add_commitment",
          "check_breaches",
          "resolve"
        ]
      }
    },
    {
      "id": "select-resolve",
      "input": "Use the resolve operation of SLA_MONITOR with {\"commitment_id\": 1}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "resolve",
            "args": {
              "commitment_id": 1
            }
          }
        ]
      },
      "forbid": {
        "tools": [
          "add_commitment",
          "check_breaches",
          "dashboard"
        ]
      }
    },
    {
      "id": "no-such-operation",
      "input": "Reformat the company logo and email it to every customer.",
      "expect": {
        "status": "answered",
        "answer_contains": [
          "cannot"
        ]
      },
      "forbid": {
        "tools": [
          "add_commitment",
          "check_breaches",
          "dashboard",
          "resolve"
        ]
      }
    },
    {

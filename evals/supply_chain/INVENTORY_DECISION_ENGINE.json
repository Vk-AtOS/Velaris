            "args": {
              "i": {
                "item_id": "sample",
                "avg_demand": 1.0,
                "demand_variance": 1.0,
                "lead_time": 1.0,
                "holding_cost": 1.0,
                "shortage_cost": 1.0,
                "order_cost": 1.0,
                "max_capacity": 1.0,
                "constraints": {}
              }
            }
          }
        ]
      },

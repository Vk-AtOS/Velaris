    {
      "id": "no-such-operation",
      "input": "Reformat the company logo and email it to every customer.",
      "expect": {
        "status": "answered",
        "answer_contains": [
          "cannot"
        ]
      },
      "forbid": {
        "tools": [
          "close_item",
          "extract_from_segments",
          "extract_from_text",
          "get_open_items",
          "get_overdue"

      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "get_open_items",
            "args": {}
          }
        ]
      },
      "forbid": {
        "tools": [
          "close_item",
          "extract_from_segments",
          "extract_from_text",
          "get_overdue"
        ]
      }
    },
    {
      "id": "select-get_overdue",
      "input": "Use the get_overdue operation of ACTION_ITEM_EXTRACTOR with {}.",
      "expect": {
        "status": "proposed",
        "calls": [
          {
            "tool": "get_overdue",
